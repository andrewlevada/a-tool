{
  "compilerOptions": {
    // Lit decorator support
    "experimentalDecorators": true,
    // Required for Lit - standard class fields break decorator initialization order
    "useDefineForClassFields": false,

    "noEmit": true,

    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "paths": {
      "@/*": ["./app/*"],
    }
  },
  "include": ["app"]
}